{
    "compilerOptions": {
        // This package imports `@feasibleone/blong-dev` sources directly, so the
        // TypeScript program spans both packages. tap's typecheck plugin needs an
        // explicit rootDir that contains every input (TS5011 otherwise), hence the
        // repository root rather than the package folder.
        "rootDir": "../..",
        "allowJs": true,
        "checkJs": false,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "module": "preserve",
        "sourceMap": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "outDir": "dist",
        "target": "ES2022",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true
    },
    "exclude": ["node_modules", ".lint", "dist"]
}
