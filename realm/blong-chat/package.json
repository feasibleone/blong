        "@feasibleone/blong-kustomize": "workspace:^0.1.0",
        "@feasibleone/blong-login": "workspace:^1.0.0",
        "@feasibleone/blong-server": "workspace:^1.0.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@feasibleone/blong-browser": "workspace:^1.0.0",
        "@feasibleone/blong-dev": "workspace:*",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-realm": "workspace:^1.0.0",
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@storybook/addon-a11y": "^10.3.6",
        "@storybook/react-vite": "^10.3.6",
        "@swc/core": "^1.7.14",
        "@types/node": "^24",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "storybook": "^10.3.6",
