{
    "name": "@feasibleone/blong-chat",
    "version": "0.3.1",
    "description": "Chat realm — Slack and Viber as one interaction surface",
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        "./server.ts": "./server.ts",
        "./browser.ts": "./browser.ts",
        "./browser.js": {
            "development": "./browser.ts",
            "import": "./browser.ts"
        },
        "./index.browser.ts": "./index.browser.ts",
        "./testPorts.ts": "./testPorts.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "blong": "blong",
        "build": "vite build",
        "build-storybook": "storybook build",
        "ci-lint": "blong-dev lint",
