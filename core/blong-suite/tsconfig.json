{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "vite.config.ts",
        "browser.ts",
        "server.ts",
        "load.ts",
        "playwright.config.ts"
    ]
}
