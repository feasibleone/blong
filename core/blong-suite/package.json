{
    "name": "@feasibleone/blong-suite",
    "version": "1.7.0",
    "private": true,
    "description": "Full-stack Blong suite template — wires blong-browser + realm packages into a runnable application with Storybook and Playwright",
    "type": "module",
    "scripts": {
        "blong": "blong",
        "blong-watch": "blong-watch",
        "build": "vite build",
        "build-storybook": "storybook build",
        "ci-lint": "blong-dev lint",
        "ci-test": "../../test/integration/wait.sh mysql && blong-dev playwright --coverage",
        "dev": "vite",
        "playwright": "blong-dev playwright",
        "playwright:update": "blong-dev playwright --update-snapshots",
        "storybook": "storybook dev -p 6006",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "@feasibleone/blong-access": "workspace:^1.0.0",
        "@feasibleone/blong-core": "workspace:^1.0.0",
        "@feasibleone/blong-marine": "workspace:^1.0.0",
        "@feasibleone/blong-server": "workspace:^1.0.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@feasibleone/blong-browser": "workspace:^1.0.0",
        "@feasibleone/blong-dev": "workspace:*",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-login": "workspace:^1.0.0",
        "@playwright/test": "^1.60.0",
        "@storybook/addon-a11y": "^10.3.6",
        "@storybook/addon-docs": "^10.3.6",
        "@storybook/react-vite": "^10.3.6",
        "@storybook/test-runner": "^0.24.3",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^6.0.1",
        "allure-playwright": "^3.6.2",
        "primeicons": "^7.0.0",
        "storybook": "^10.3.6",
        "typescript": "^6.0.3",
        "vite": "^8.0.8",
        "vite-plugin-csp-guard": "^4.0.1",
        "vite-plugin-dts": "^4.5.4"
    }
}
