{
    "name": "@feasibleone/blong-core",
    "version": "1.1.1",
    "description": "Core utility realm — reusable DB schemas for resource, type, property, triple, translation, and path tables",
    "type": "module",
    "exports": {
        "./server.ts": "./server.ts",
        "./browser.ts": "./browser.ts",
        "./browser.js": {
            "development": "./browser.ts",
            "import": "./browser.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "blong": "blong",
        "blong-watch": "blong-watch",
        "build": "true",
        "ci-lint": "blong-dev lint",
        "dev": "vite",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-login": "workspace:^1.0.0",
        "@feasibleone/blong-server": "workspace:^1.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.1"
    }
}
