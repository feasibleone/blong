{
    "name": "@feasibleone/blong-marine",
    "version": "1.2.0",
    "description": "Marine biology demo realm — shared schema, fixtures, and model specs for the Blong ecosystem",
    "type": "module",
    "exports": {
        "./server.ts": "./server.ts",
        "./browser.ts": "./browser.ts",
        "./browser.js": {
            "development": "./browser.ts",
            "import": "./browser.ts"
        },
        "./data": {
            "development": "./data/index.ts",
            "import": "./data/index.ts"
        },
        "./data/index.ts": "./data/index.ts",
        "./storybook.ts": "./storybook.ts",
        "./storybook.js": {
            "development": "./storybook.ts",
            "import": "./storybook.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "blong": "blong",
        "blong-watch": "blong-watch",
        "build": "true",
        "build-storybook": "storybook build",
        "ci-lint": "blong-dev lint",
        "dev": "vite",
        "playwright": "blong-dev playwright",
        "playwright:update": "blong-dev playwright --update-snapshots",
        "storybook": "storybook dev -p 6007",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@feasibleone/blong-browser": "workspace:^1.0.0",
        "@feasibleone/blong-dev": "workspace:*",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-login": "workspace:^1.0.0",
        "@feasibleone/blong-server": "workspace:^1.0.0",
        "@feasibleone/marine-data": "workspace:^1.0.0",
        "@playwright/test": "^1.60.0",
        "@storybook/addon-a11y": "^10.3.6",
        "@storybook/react-vite": "^10.3.6",
        "@storybook/test-runner": "^0.24.3",
        "@types/node": "^24",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^6.0.1",
        "allure-playwright": "^3.6.2",
        "primeicons": "^7.0.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "storybook": "^10.3.6",
        "typescript": "^6.0.3",
        "vite": "^8.0.8"
    }
}
