{
    "name": "@feasibleone/semantic-log",
    "version": "1.3.0",
    "description": "Semantic logging front door: standard readable output with locally-minted cross-reference ids",
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        ".": "./index.ts",
        "./emitter": "./emitter.ts",
        "./service": "./service.ts",
        "./capability": "./capability.ts",
        "./attachable": "./attachable.ts"
    },
    "bin": {
        "semantic-log-flow": "./flow/run.ts",
        "semantic-log-inspect": "./bin/semantic-log-inspect.ts",
        "semantic-log-service": "./bin/semantic-log-service.ts"
    },
    "scripts": {
        "build": "true",
        "ci-lint": "blong-dev lint",
        "ci-publish": "node ../../common/scripts/install-run-rush-pnpm.js publish --access public --provenance",
        "ci-test": "blong-dev test --jobs=1",
        "test": "blong-dev test"
    },
    "dependencies": {
        "cacache": "^20.0.4",
        "fastify": "^5.12.3",
        "ulidx": "^2.4.1"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@types/cacache": "^20.0.1",
        "@types/node": "^24",
        "tap": "^21.6.3"
    },
    "optionalDependencies": {
        "@huggingface/transformers": "^4"
    }
}
