{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "sourceMap": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "target": "ES2022",
        "module": "preserve",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "ts-node": {
        "esm": true,
        "swc": true,
        "transpileOnly": true,
        "files": true,
        "experimentalResolver": true
    },
    "exclude": ["node_modules", "dist", ".tap"],
    "include": ["**/*.ts"]
}
