// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Loader > renders nothing when not loading 1`] = `<div />`;

exports[`Loader > renders overlay when loading is active 1`] = `
<div>
  <div
    aria-live="polite"
    class="blong-loader-overlay"
    role="status"
  >
    <div
      class="blong-loader-content"
    >
      <div
        aria-busy="true"
        class="p-progress-spinner"
        data-pc-name="progressspinner"
        data-pc-section="root"
        role="progressbar"
        style="width: 50px; height: 50px;"
      >
        <svg
          class="p-progress-spinner-svg"
          data-pc-section="spinner"
          style="animation-duration: .8s;"
          viewBox="25 25 50 50"
        >
          <circle
            class="p-progress-spinner-circle"
            cx="50"
            cy="50"
            data-pc-section="circle"
            fill="none"
            r="20"
            stroke-miterlimit="10"
            stroke-width="4"
          />
        </svg>
      </div>
      <p
        class="blong-loader-message"
      >
        Please wait…
      </p>
    </div>
  </div>
</div>
`;
