exports[`Login > renders with register button 1`] = `
<div>
  <div
    class="blong-login p-component"
  >
    <div
      class="blong-login__register-area"
    >
      <button
        aria-label="Register"
        class="p-button-outlined p-button p-component"
        data-pc-name="button"
        data-pc-section="root"
      >
        <span
          class="p-button-label p-c"
          data-pc-section="label"
        >
          <span>
            Register
          </span>
        </span>
      </button>
    </div>
    <div
      class="blong-login__top"
    >
      <div
        class="blong-login__brand"
      >
        <i
          class="blong-login__brand-icon pi pi-circle"
        />
      </div>
    </div>
    <div
      class="blong-login__card"
    >
      <p
        class="blong-login__card-heading"
      >
        Login with password
      </p>
      <form
        class="blong-login__form"
      >
        <div
          class="blong-field"
        >
          <label
            class="blong-field__label"
            for="login-username"
          >
            Username
          </label>
          <input
            class="blong-login__input w-full p-inputtext p-component"
            data-pc-name="inputtext"
            data-pc-section="root"
            id="login-username"
            name="username"
            value=""
          />
        </div>
        <div
          class="blong-field"
        >
          <label
            class="blong-field__label"
            for="login-password"
          >
            Password
          </label>
          <div
            class="blong-login__input w-full p-password p-component p-inputwrapper p-input-icon-right"
            data-pc-name="password"
            data-pc-section="root"
          >
            <div
              class="p-icon-field p-icon-field-right"
              data-pc-name="iconfield"
              data-pc-section="root"
            >
              <input
                class="w-full p-password-input p-inputtext p-component"
                data-pc-name="inputtext"
                data-pc-section="root"
                id="login-password"
                name="password"
                tabindex="0"
                type="password"
                value=""
              />
              <span
                class="p-input-icon"
                data-pc-name="inputicon"
                data-pc-section="root"
              >
                <svg
                  aria-checked="true"
                  aria-label="Show Password"
                  class="p-icon p-password-show-icon"
                  data-pc-section="showicon"
                  fill="none"
                  height="14"
                  role="switch"
                  tabindex="0"
                  viewBox="0 0 14 14"
                  width="14"
                  xmlns="http://www.w3.org/2000/svg"
                >
