exports[`Login > renders with external error 1`] = `
<div>
  <div
    class="blong-login"
  >
    <div
      class="blong-login__card"
    >
      <h2
        class="blong-login__title"
      >
        Sign In
      </h2>
      <div
        aria-live="polite"
        class="p-inline-message p-component p-inline-message-error blong-login__error"
        role="alert"
      >
        <span
          class="p-inline-message-icon pi pi-times-circle"
        />
        <span
          class="p-inline-message-text"
        >
