// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Login > renders the login form 1`] = `
<div>
  <div
    class="blong-login"
  >
    <div
      class="blong-login__card"
    >
      <h2
        class="blong-login__title"
      >
        Sign In
      </h2>
      <form
        class="blong-login__form"
      >
        <div
          class="blong-field"
        >
          <label
            class="blong-field__label"
            for="login-username"
          >
            Username
          </label>
          <input
            class="p-inputtext p-component blong-login__input"
            id="login-username"
            name="username"
            value=""
          />
        </div>
        <div
          class="blong-field"
        >
          <label
            class="blong-field__label"
            for="login-password"
          >
            Password
          </label>
          <div
            class="p-password p-component p-inputwrapper p-input-icon-right blong-login__input"
          >
            <input
              class="p-inputtext p-component p-password-input"
              id="login-password"
              name="password"
              type="password"
              value=""
            />
            <i
              class="pi pi-eye"
            />
          </div>
        </div>
        <button
          aria-label="Sign In"
          class="p-button p-component blong-login__submit"
          type="submit"
        >
          <span
            class="p-button-icon p-c p-button-icon-undefined pi pi-sign-in"
          />
          <span
            class="p-button-label p-c"
          >
            <span>
              Sign In
            </span>
          </span>
        </button>
      </form>
    </div>
  </div>
</div>
`;

