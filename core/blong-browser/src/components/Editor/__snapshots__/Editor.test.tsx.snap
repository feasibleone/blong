                class="blong-card__body"
              >
                <div
                  class="field grid mb-0"
                >
                  <div
                    class="flex align-items-center relative col-12"
                  >
                    <div
                      class="blong-multiselect w-full  p-multiselect p-component p-inputwrapper p-multiselect-chip"
                      data-pc-name="multiselect"
                      data-pc-section="root"
                      data-testid="habitat"
                    >
                      <div
                        class="p-hidden-accessible"
                        data-p-hidden-accessible="true"
                        data-pc-section="hiddeninputwrapper"
                      >
                        <input
                          aria-expanded="false"
                          data-pc-section="input"
                          id="habitat"
                          readonly=""
                          role="combobox"
                          tabindex="0"
                          type="text"
                          value=""
                        />
                      </div>
                      <div
                        class="p-multiselect-panel p-component p-multiselect-inline p-multiselect-flex p-ripple-disabled"
