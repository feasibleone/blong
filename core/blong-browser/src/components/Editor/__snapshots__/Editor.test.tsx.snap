                                    />
                                  </div>
                                </th>
                              </tr>
                            </thead>
                            <tbody
                              class="p-datatable-tbody"
                            >
                              <tr
                                class="p-datatable-emptymessage"
                                role="row"
                              >
                                <td
                                  colspan="4"
                                  role="cell"
                                >
                                  No results found
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="blong-deck col-12 xl:col-6"
      >
        <div
          class="p-card p-component w-full"
          id="card-habitat"
        >
          <div
            class="p-card-body"
          >
            <div
              class="p-card-title"
            >
              <span
                class="blong-card__label"
              >
                <span>
                  Местообитание
                </span>
              </span>
            </div>
            <div
              class="p-card-content"
            >
              <div
                class="blong-card__body"
              >
                <div
                  class="field grid mb-0"
                >
                  <div
                    class="flex align-items-center relative col-12"
                  >
                    <div
                      class="p-multiselect p-component p-inputwrapper p-multiselect-chip blong-multiselect w-full "
                    >
                      <div
                        class="p-hidden-accessible"
                      >
                        <input
                          aria-expanded="false"
                          id="habitat"
                          readonly=""
                          role="listbox"
                          type="text"
                        />
                      </div>
                      <div
                        class="p-multiselect-panel p-component p-multiselect-inline p-multiselect-flex"
                      >
                        <div
                          class="p-multiselect-items-wrapper"
                        >
                          <ul
                            aria-multiselectable="true"
                            class="p-multiselect-items p-component"
                            role="listbox"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>
`;
