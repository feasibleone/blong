exports[`<Editor /> > EditorTabsExplorer render equals snapshot 1`] = `
<div
  class="blong-editor "
  data-testid="blong-browser-test"
>
  <div
    class="border-none border-bottom-1 border-50 p-2 p-toolbar p-component"
    data-pc-name="toolbar"
    data-pc-section="root"
    role="toolbar"
    style="background: none;"
  >
    <div
      class="p-toolbar-group-start p-toolbar-group-left"
      data-pc-section="start"
    >
      <div
        class="blong-toolbar-left"
      >
