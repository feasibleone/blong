exports[`<Editor /> > Pivot BG render equals snapshot 1`] = `
<div
  class="blong-editor "
  data-testid="blong-browser-test"
>
  <div
    class="border-none border-bottom-1 border-50 p-2 p-toolbar p-component"
    data-pc-name="toolbar"
    data-pc-section="root"
    role="toolbar"
    style="background: none;"
  >
    <div
      class="p-toolbar-group-start p-toolbar-group-left"
      data-pc-section="start"
    >
      <div
        class="blong-toolbar-left"
      >
        <button
          aria-label="Edit"
          class="p-button p-component p-button-icon-only mr-2"
          type="button"
        >
          <span
            class="p-button-icon p-c pi pi pi-pencil"
          />
          <span
            class="p-button-label p-c"
          >
             
          </span>
        </button>
      </div>
    </div>
    <div
      class="p-toolbar-group-center"
      data-pc-section="center"
    />
    <div
      class="p-toolbar-group-end p-toolbar-group-right"
      data-pc-section="end"
    />
  </div>
  <form
    class="blong-form"
    id="_r_k_"
    novalidate=""
  >
    <div
      class="grid col align-self-start max-w-screen"
    />
  </form>
</div>
`;

