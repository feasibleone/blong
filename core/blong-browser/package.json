{
    "name": "@feasibleone/blong-browser",
    "version": "1.6.2",
    "private": true,
    "description": "React UI component library and portal framework for the Blong ecosystem",
    "keywords": [
        "blong",
        "ui",
        "react",
        "portal",
        "framework"
    ],
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/blong-browser.es.js"
        },
        "./browser.js": {
            "development": "./browser.ts",
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./browser.ts": "./browser.ts",
        "./storybook": {
            "development": "./src/storybook.ts",
            "types": "./dist/storybook.d.ts",
            "import": "./dist/storybook.es.js"
        },
        "./storybook.tsx": "./storybook.tsx",
        "./package.json": "./package.json"
    },
    "main": "./dist/blong-browser.es.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        ".ci-publish": "node ../../common/scripts/install-run-rush-pnpm.js publish --access public --provenance",
        "build": "true",
        "build:watch": "vite build --watch",
        "build-storybook": "storybook build -o storybook-static",
        "build_": "vite build && tsc --emitDeclarationOnly && tsc --project tsconfig.realm.json",
        "ci-chromatic": "../common/chromatic.sh",
        "ci-lint": "blong-dev lint",
        "ci-unit": "node --run test",
        "storybook": "storybook dev --port 6006",
        "storybook:test": "test-storybook",
        "storybook:test:ci": "storybook build -o storybook-static && npx --yes http-server storybook-static --port 6006 --silent & sleep 3 && npx test-storybook --url http://127.0.0.1:6006; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
        "test": "vitest run",
        "test-coverage": "vitest run --coverage",
        "test-update": "vitest run -u",
        "test-watch": "vitest",
        "visual:update": "npm run storybook:test -- --updateSnapshot"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@feasibleone/blong": "workspace:^1.0.0",
        "@tanstack/react-query": "^5.67.3",
        "ky": "^1.14.2",
        "zustand": "^5.0.4"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-marine": "workspace:^1.0.0",
        "@storybook/addon-a11y": "^10.3.6",
        "@storybook/addon-docs": "^10.3.6",
        "@storybook/react-vite": "^10.3.6",
        "@storybook/test-runner": "^0.24.3",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.5",
        "chromatic": "^16.1.0",
        "jsdom": "^26.0.0",
        "primeflex": "^3.3.0",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.7",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.54.2",
        "storybook": "^10.3.6",
        "typescript": "^5.9.3",
        "vite": "^8.0.8",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.5"
    },
    "peerDependencies": {
        "primeflex": "^3.3.0",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.7",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.54.2"
    }
}
