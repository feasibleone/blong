{
    "compilerOptions": {
        "rootDir": ".",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "module": "ESNext",
        "sourceMap": true,
        "jsx": "react-jsx",
        "outDir": "dist",
        "target": "ES2022",
        "declaration": true,
        "declarationMap": true,
        "resolveJsonModule": true,
        "strict": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "dist", "stories", ".storybook"]
}
