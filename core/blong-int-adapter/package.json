{
    "name": "@feasibleone/blong-int-adapter",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "true",
        "ci-integration-mysql": "../../test/integration/wait.sh && BLONG_ENV=adapter.mysql tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-mongodb": "../../test/integration/wait.sh && BLONG_ENV=adapter.mongodb tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-http": "BLONG_ENV=adapter.http tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-s3": "../../test/integration/wait.sh && BLONG_ENV=adapter.s3 tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-kafka": "../../test/integration/wait.sh && BLONG_ENV=adapter.kafka tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-vault": "../../test/integration/wait.sh && BLONG_ENV=adapter.vault tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-keycloak": "../../test/integration/wait.sh && BLONG_ENV=adapter.keycloak tap index.test.ts --allow-incomplete-coverage",
        "ci-integration-k8s": "BLONG_ENV=adapter.k8s tap index.test.ts --allow-incomplete-coverage"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@swc/core": "^1.7.14",
        "@types/node": "^24",
        "tap": "^21.6.3",
        "typescript": "^5.9.3"
    }
}
