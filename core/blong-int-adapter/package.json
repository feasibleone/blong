{
    "name": "@feasibleone/blong-int-adapter",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "true",
        "ci-integration": "./integration-test.sh",
        "ci-integration-http": "tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.http",
        "ci-integration-k8s": "tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.k8s",
        "ci-integration-kafka": "../../test/integration/wait.sh kafka && tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.kafka",
        "ci-integration-keycloak": "../../test/integration/wait.sh keycloak && tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.keycloak",
        "ci-integration-mongodb": "../../test/integration/wait.sh mongodb && tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.mongodb",
        "ci-integration-mysql": "../../test/integration/wait.sh mysql && tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.mysql",
        "ci-integration-s3": "../../test/integration/wait.sh minio && tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.s3",
        "ci-integration-vault": "../../test/integration/wait.sh vault && tap index.test.ts --allow-incomplete-coverage --test-arg=adapter.vault"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@swc/core": "^1.7.14",
        "@types/node": "^24",
        "tap": "^21.6.3",
        "typescript": "^5.9.3"
    }
}
