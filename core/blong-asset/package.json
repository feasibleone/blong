{
    "name": "@feasibleone/blong-asset",
    "version": "0.1.0",
    "description": "Static asset server for a Blong suite's browser bundle",
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        ".": "./index.ts",
        "./plugin.ts": "./src/assetPlugin.ts",
        "./package.json": "./package.json"
    },
    "bin": {
        "blong-asset": "./bin/blongAsset.ts"
    },
    "scripts": {
        "build": "true",
        "ci-lint": "blong-dev lint",
        "ci-test": "blong-dev test"
    },
    "dependencies": {
        "@fastify/static": "^10.1.6",
        "fastify": "^5.12.7",
        "fastify-plugin": "^6.0.0"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@types/node": "^24",
        "tap": "^21.6.3",
        "typescript": "^6.0.3"
    }
