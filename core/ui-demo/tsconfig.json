{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "vite.config.ts",
        "browser.ts",
        "marine/**/*.ts",
        "marine/**/*.tsx"
    ]
}
