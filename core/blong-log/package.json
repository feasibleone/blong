{
    "name": "@feasibleone/blong-log",
    "version": "1.3.1",
    "description": "Real-time log viewer for the Blong framework",
    "keywords": [
        "blong",
        "log",
        "real-time",
        "pino",
        "transport"
    ],
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./transport": "./src/transport.ts",
        "./server": "./src/server.ts"
    },
    "bin": {
        "blong-log": "./src/cli.ts"
    },
    "scripts": {
        "ci-lint": "tsc --noEmit",
        "build": "heft build --clean && node build-client.js",
        "build-storybook": "storybook build -o storybook-static",
        "ci-chromatic": "../common/chromatic.sh",
        "storybook": "storybook dev -p 6006",
        "storybook:test": "test-storybook",
        "storybook:test:ci": "storybook build -o storybook-static && npx --yes http-server storybook-static --port 6006 --silent & sleep 3 && npx test-storybook --url http://127.0.0.1:6006; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
        "test": "tap src/**/*.test.ts",
        "visual:update": "npm run storybook:test -- --updateSnapshot"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "pino": "^10.3.1",
        "pino-abstract-transport": "^3.0.0",
        "typebox": "^1.1.5",
        "ulidx": "^2.4.1",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@storybook/addon-a11y": "^10.3.6",
        "@storybook/addon-docs": "^10.3.6",
        "@storybook/react-vite": "^10.3.6",
        "@storybook/test-runner": "^0.24.3",
        "@svar-ui/react-grid": "^2.5.2",
        "@testing-library/dom": "^10.4.1",
        "@types/node": "^24",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@types/ws": "^8.18.0",
        "chromatic": "^16.1.0",
        "esbuild": "^0.27.1",
        "jest-image-snapshot": "^6.5.1",
        "playwright": "^1.58.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "storybook": "^10.3.6",
        "tap": "^21.6.3",
        "typescript": "^5.9.3",
        "vite": "^8.0.8"
    }
}
