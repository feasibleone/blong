{
    "name": "@feasibleone/blong-party",
    "version": "1.1.0",
    "description": "Party management realm — persons, organizations, units, contacts, addresses, and identifiers",
    "type": "module",
    "exports": {
        "./server.ts": "./server.ts",
        "./browser.ts": "./browser.ts",
        "./browser.js": {
            "development": "./browser.ts",
            "import": "./browser.ts"
        },
        "./index.browser.ts": "./index.browser.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "blong": "blong",
        "blong-watch": "blong-watch",
        "build": "true",
        "ci-lint": "blong-dev lint",
        "ci-test": "../../test/integration/wait.sh mysql && blong-dev test && blong-dev playwright --coverage",
        "dev": "vite",
        "playwright": "blong-dev playwright",
        "playwright:update": "blong-dev playwright --update-snapshots",
        "test": "blong-dev test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@feasibleone/blong-access": "workspace:^1.0.0",
        "@feasibleone/blong-browser": "workspace:^1.0.0",
        "@feasibleone/blong-core": "workspace:^1.0.0",
        "@feasibleone/blong-dev": "workspace:*",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-login": "workspace:^1.0.0",
        "@feasibleone/blong-server": "workspace:^1.0.0",
        "@feasibleone/blong-test": "workspace:^1.0.0",
        "@playwright/test": "^1.60.0",
        "@types/node": "^24",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "allure-playwright": "^3.6.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tap": "^21.6.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.8"
    }
}
