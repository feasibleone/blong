{
    "name": "@feasibleone/blong-ttk",
    "version": "1.2.0",
    "description": "Testing Toolkit for Mojaloop and other services - TypeScript test execution with Blong patterns",
    "keywords": [
        "blong",
        "testing",
        "mojaloop",
        "test-automation"
    ],
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        ".": "./index.ts",
        "./server": "./server.ts"
    },
    "scripts": {
        "build": "heft build --clean",
        "ci-lint": "blong-dev lint",
        "ci-unit": "tap index.test.ts --allow-incomplete-coverage",
        "test": "tap *.test.ts"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "@feasibleone/blong-allure": "workspace:^1.0.0",
        "@feasibleone/blong-chain": "workspace:^1.0.0",
        "@feasibleone/blong-gogo": "workspace:^1.0.0",
        "@feasibleone/blong-openapi": "workspace:^1.0.0",
        "@infitx/decision": "^1.0.0",
        "p-queue": "^9.1.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@types/node": "^24",
        "tap": "^21.6.3",
        "typescript": "^5.9.3"
    }
}
