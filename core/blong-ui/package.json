{
    "name": "@feasibleone/blong-ui",
    "version": "1.0.0",
    "description": "Metadata-driven browser UI framework for Blong",
    "keywords": [
        "blong",
        "ui",
        "browser",
        "primereact",
        "react-hook-form",
        "metadata-driven"
    ],
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./auth": "./src/auth/index.ts"
    },
    "scripts": {
        "build": "heft build --clean",
        "build-storybook": "storybook build -o storybook-static",
        "ci-chromatic": "../common/chromatic.sh",
        "ci-storybook": "storybook build -o storybook-static && npx --yes http-server storybook-static --port 6006 --silent & sleep 3 && npx test-storybook --url http://127.0.0.1:6006; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
        "storybook": "storybook dev -p 6006",
        "storybook:test": "test-storybook",
        "storybook:test:ci": "storybook build -o storybook-static && npx --yes http-server storybook-static --port 6006 --silent & sleep 3 && npx test-storybook --url http://127.0.0.1:6006; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
        "visual:update": "storybook build -o storybook-static && npx --yes http-server storybook-static --port 6006 --silent & sleep 3 && npx test-storybook --url http://127.0.0.1:6006 --updateSnapshot; EXIT=$?; kill %1 2>/dev/null; exit $EXIT"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "@hookform/resolvers": "^5.0.1",
        "@tanstack/react-query": "^5.75.5",
        "openapi-types": "^12.1.3",
        "primereact": "^10.9.5",
        "react-hook-form": "^7.56.4",
        "react-router-dom": "^7.12.0",
        "typebox": "^1.1.5"
    },
    "devDependencies": {
        "@rushstack/eslint-config": "^4.6.4",
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@storybook/addon-a11y": "^10.2.14",
        "@storybook/addon-docs": "^10.2.14",
        "@storybook/react-vite": "^10.2.14",
        "@storybook/test": "^8.6.15",
        "@storybook/test-runner": "^0.24.2",
        "@testing-library/dom": "^10.4.1",
        "@types/node": "^24",
        "@types/react": "^18.3.4",
        "@types/react-dom": "^18.3.1",
        "chromatic": "^15.2.0",
        "eslint": "~9.39.2",
        "jest-image-snapshot": "^6.5.1",
        "ky": "^1.14.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "storybook": "^10.2.14",
        "typescript": "^5.9.3",
        "vite": "^6.4.1"
    },
    "peerDependencies": {
        "ky": "^1.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
