{
    "name": "@feasibleone/blong-ui",
    "version": "1.0.0",
    "description": "React UI component library and portal framework for the Blong ecosystem",
    "keywords": [
        "blong",
        "ui",
        "react",
        "portal",
        "framework"
    ],
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/blong-ui.es.js",
            "types": "./dist/index.d.ts",
            "development": "./src/index.ts"
        },
        "./browser.js": {
            "import": "./dist/browser.js",
            "types": "./dist/browser.d.ts",
            "development": "./browser.ts"
        },
        "./browser.ts": "./browser.ts",
        "./storybook": {
            "import": "./dist/storybook.es.js",
            "types": "./dist/storybook.d.ts",
            "development": "./src/storybook.ts"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/blong-ui.es.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly && tsc --project tsconfig.realm.json",
        "build:watch": "vite build --watch",
        "build-storybook": "storybook build",
        "ci-publish": "node ../../common/scripts/install-run-rush-pnpm.js publish --access public --provenance",
        "storybook": "storybook dev --port 6006",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@feasibleone/blong": "workspace:^1.0.0",
        "@tanstack/react-query": "^5.67.3",
        "ky": "^1.14.2",
        "zustand": "^5.0.4"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.5",
        "@rushstack/eslint-config": "^4.6.4",
        "@storybook/addon-a11y": "^10.2.14",
        "@storybook/addon-docs": "^10.2.14",
        "@storybook/addon-essentials": "^8.6.14",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/react": "^10.2.14",
        "@storybook/react-vite": "^10.2.14",
        "@storybook/test": "^8.6.1",
        "@storybook/test-runner": "^0.24.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^3.0.9",
        "eslint": "~9.39.2",
        "jsdom": "^26.0.0",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.54.2",
        "storybook": "^10.2.14",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vite-plugin-dts": "^4.5.3",
        "vitest": "^3.0.9"
    },
    "peerDependencies": {
        "@primereact/themes": "^10.0.19",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.54.2"
    }
}
