{
    "name": "@feasibleone/blong-access",
    "version": "1.1.0",
    "description": "RBAC access control realm — user profiles, credentials, actions, capabilities, roles, policies, and access flows",
    "type": "module",
    "exports": {
        "./server.ts": "./server.ts",
        "./browser.ts": "./browser.ts",
        "./browser.js": {
            "development": "./browser.ts",
            "import": "./browser.ts"
        },
        "./package.json": "./package.json"
