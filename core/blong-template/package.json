{
    "name": "@feasibleone/blong-template",
    "version": "1.0.0",
    "description": "TypeScript template engine for the Blong framework — trusted and sandboxed modes with XML/HTML/JSON escaping helpers",
    "keywords": [
        "blong",
        "template",
        "interpolation",
        "escaping",
        "sandbox"
    ],
    "repository": {
        "url": "git+https://github.com/feasibleone/blong.git"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "browser": {
                "types": "./types/browser.d.ts",
                "default": "./browser.ts"
            },
            "default": "./index.ts"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "ci-lint": "blong-dev lint",
        "ci-test": "blong-dev test"
    },
    "dependencies": {
        "acorn": "^8.16.0"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@types/node": "^24",
        "tap": "^21.6.3",
        "typescript": "^6.0.3"
    }
}
