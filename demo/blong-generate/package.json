{
    "name": "@feasibleone/blong-generate",
    "version": "0.1.0",
    "private": true,
    "description": "Shows and tests how handler stubs are generated from published API definitions, and keeps them in step with a check/update script.",
    "type": "module",
    "scripts": {
        "blong": "blong",
        "build": "true",
        "ci-lint": "blong-dev lint",
        "ci-test": "blong-dev test",
        "generate:check": "node generate.tool.ts",
        "generate:update": "node generate.tool.ts --update",
        "test": "blong-dev test"
    },
    "dependencies": {
        "@feasibleone/blong": "workspace:^1.0.0",
        "@feasibleone/blong-gogo": "workspace:^1.0.0"
    },
    "devDependencies": {
        "@feasibleone/blong-dev": "workspace:*",
        "@rushstack/heft": "^1.2.6",
        "@rushstack/heft-lint-plugin": "^1.2.6",
        "@rushstack/heft-typescript-plugin": "^1.3.1",
        "@swc/core": "^1.7.14",
        "@types/node": "^24",
        "tap": "^21.6.3",
        "typescript": "^6.0.3"
    }
}
