{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Blong Watch",
            "program": "${workspaceFolder}/core/blong-gogo/bin/blong-watch.ts",
            "request": "launch",
            "cwd": "${workspaceFolder}/${input:blong-package}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "type": "node"
        },
        {
            "name": "Attach",
            "port": 9229,
            "request": "attach",
            "skipFiles": ["<node_internals>/**"],
            "type": "node"
        },
        {
            "name": "Test blong",
            "program": "${workspaceFolder}/test/framework/index.test.ts",
            "cwd": "${workspaceFolder}/test/framework",
            "request": "launch",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "type": "node"
        },
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/ext/rest-fs",
                "--disable-extensions"
            ],
            "outFiles": ["${workspaceFolder}/ext/rest-fs/dist/**/*.js"],
            "preLaunchTask": "${defaultBuildTask}",
            "sourceMaps": true
        },
        {
            "name": "Run Extension (No Build)",
            "type": "extensionHost",
            "request": "launch",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}/ext/rest-fs"],
            "outFiles": ["${workspaceFolder}/ext/rest-fs/dist/**/*.js"],
            "sourceMaps": true
        },
        {
            "name": "Run Extension (with sample workspace)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/ext/rest-fs",
                "${workspaceFolder}/ext/rest-fs/example-server"
            ],
            "outFiles": ["${workspaceFolder}/ext/rest-fs/dist/**/*.js"],
            "preLaunchTask": "${defaultBuildTask}"
        },
        {
            "name": "Extension Tests",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/ext/rest-fs",
                "--extensionTestsPath=${workspaceFolder}/ext/rest-fs/out/test/suite/index"
            ],
            "outFiles": ["${workspaceFolder}/ext/rest-fs/out/test/**/*.js"],
            "preLaunchTask": "${defaultBuildTask}"
        }
    ],
    "inputs": [
        {
            "id": "blong-package",
            "type": "pickString",
            "description": "Select a blong package to run",
            "options": [
                "core/blong-cucumber",
                "demo/blong-eip",
                "demo/blong-hello",
                "test/blong-int-sql",
                "test/blong-sim-api",
                "test/blong-sim-tcp",
                "realm/blong-test",
                "core/config-hot-reload",
                "demo/handler-test-poc",
                "test/framework",
                "suite/blong-suite"
            ],
            "default": "test/framework"
        }
    ]
}
