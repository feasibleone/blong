# Dependencies
/node_modules

# Production
/build

# The Storybooks the pages embed (`storybook-sites.json`), staged by `npm run stage-storybook`.
# A build output of the packages they belong to — 10 to 30 MB each — so it is rebuilt for a deploy
# rather than committed, and a plain `npm run build` renders each embed's poster instead.
/static/storybook

# The interactive diagrams the pages embed (`diagrams.json`), staged by `npm run stage-diagrams`.
# A self-contained build output of about a megabyte per diagram, rendered by a tool this repository
# does not depend on, so it is rebuilt for a deploy rather than committed — and a plain
# `npm run build` renders each embed's committed poster instead.
/static/diagrams

# Generated files
.docusaurus
.cache-loader

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
