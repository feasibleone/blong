    "cards": [
        {
            "dot": "rose",
            "title": "Two things the gateway adds",
            "items": [
                "Authorization reads the role bits the token carries, and the expansion is cached per role bit",
                "Validation uses the schema generated from the handler's own Handler type, so the check cannot drift from the code"
            ]
        },
        {
            "dot": "emerald",
            "title": "Invariants of a call",
            "items": [
                "Every dispatch is made through the handler() proxy \u2014 direct imports break inversion of control",
                "$meta is forwarded as the second argument at every hop",
                "A typed error travels with its parameters; $meta.expect marks the ones a test expects"
            ]
        },
        {
            "dot": "cyan",
            "title": "Beyond the reply",
            "items": [
                "A checkpoint records the step a run reached and the branch it took",
                "The semantic log turns those records into the observed flows the docs draw",
                "Logs, metrics and traces leave the process on their own path"
            ]
        }
    ]
}
