    "cards": [
        {
            "dot": "cyan",
            "title": "Names carry the hierarchy",
            "items": [
                "A handler is named subjectObjectPredicate: subject is the namespace, object the entity, predicate the action",
                "The file, the export and the wire name are the same triple",
                "Standard predicates come first: get, find, add, edit, remove, merge, insert, update, delete"
            ]
        },
        {
            "dot": "emerald",
            "title": "A layer is a folder of handler groups",
            "items": [
                "Well-known layers are discovered without configuration: error, sim, adapter, orchestrator, gateway, meta, test",
                "Which of them activate is decided by the intents the process was started with",
                "Adapters never call adapters: coordination belongs to an orchestrator"
            ]
        },
        {
            "dot": "amber",
            "title": "Library realms are carried, not called",
            "items": [
                "A library realm travels with every process that uses it, and its schema is created in each database",
                "The call stays in the process and joins the caller's transaction",
                "blong-party is a normal realm: its data must not be copied per database"
            ]
        }
    ]
