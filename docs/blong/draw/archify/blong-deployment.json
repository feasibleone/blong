    "cards": [
        {
            "dot": "cyan",
            "title": "The deployment map",
            "items": [
                ".github/deployments.json is the only place a suite is named",
                "An alias names its release component, its rush deploy scenario, the artifact, the namespace and the profile",
                "Its follows list says which other components' releases re-deploy it, because a realm or framework release publishes no release of the suite",
                "The entry marked installer is the operator's own install, and resolve keeps it out of the matrix"
            ]
        },
        {
            "dot": "amber",
            "title": "One batch, one commit",
            "items": [
                "release-please publishes the whole batch at once and tags every release of it at the same commit",
                "The newest tag of the batch builds every artifact, so a gogo release and a marine release carry the same tree",
                "A batch that names nothing a deployment follows plans an empty run and reports a notice",
                "A release is not a promise that its framework image is pullable yet, so resolve waits for it"
            ]
        },
        {
            "dot": "rose",
            "title": "One door into the cluster",
            "items": [
                "The only credential the workflow holds is the operator's release token",
                "It addresses one JSON-RPC route, and the check happens before the handler that touches the CR",
                "The suite's own manifests never carry the operator, only the CR and the bindings it needs"
            ]
        }
    ]
}
