    "cards": [
        {
            "dot": "cyan",
            "title": "Six processes, and they are not alike",
            "items": [
                "admin: a gateway, an orchestrator, a SQL adapter and an object adapter",
                "app: the same with one adapter; pos: no gateway, the device speaks a protocol into a stream adapter",
                "chat: no gateway either \u2014 the platform posts to a webhook adapter, and the answer leaves through an SDK",
                "agent: a worker nothing calls; it claims a ticket and asks a person through chat's private API",
                "fspiop: a partner gateway, an orchestrator, and an adapter that leaves the cluster"
            ]
        },
        {
            "dot": "emerald",
            "title": "What the arrow colours mean",
            "items": [
                "Red: the public API \u2014 a caller or a platform arrives at a gateway or a webhook",
                "Neutral: the private API \u2014 dispatch to an orchestrator, a claim, and one realm calling another",
                "Green: an integration \u2014 into an adapter, and the adapter into the store or the external API it talks to",
                "Red dashed: an orchestrator reaching another realm's adapter, which is possible and discouraged"
            ]
        },
        {
            "dot": "amber",
            "title": "Stores, and where a schema lives",
            "items": [
                "A realm owns its schema, not the server: one MySQL can hold admin and app, another holds pos",
                "A schema belongs to one database, so the same deployment can split them and a second server is a config change",
                "Object storage is a store too \u2014 files and documents a realm owns, written by an object adapter",
                "The agent's workspace is a volume, one claim per host, because a resume must find the files a session made"
            ]
        }
    ]
