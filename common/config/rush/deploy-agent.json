/**
 * Deploy scenario for the agent suite: `rush deploy --scenario agent`.
 *
 * The artifact is the agent suite and the realms it loads — the portal, login, core, access, the
 * gateway, the viewer and the chat realm whose Slack and Viber paths the agents ask their questions
 * through — resolved so that no `node_modules` outside it is needed. The options mirror
 * `deploy-chat.json` on purpose: `linkCreation: script` is the link step the fill Job runs, and
 * `includeNpmIgnoreFiles: true` keeps the sources a deployment imports but a publish would drop.
 */
{
    "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/deploy-scenario.schema.json",
    "deploymentProjectNames": ["@feasibleone/blong-agent"],
    "linkCreation": "script",
    "includeNpmIgnoreFiles": true
}
