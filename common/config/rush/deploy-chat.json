/**
 * Deploy scenario for the chat suite: `rush deploy --scenario chat`.
 *
 * The artifact is the chat suite and the realms it loads — the portal, login, core, access, the
 * gateway and the chat realm itself — resolved so that no `node_modules` outside it is needed. The
 * options mirror `deploy-sport.json` on purpose: `linkCreation: script` is the link step the fill Job
 * runs, and `includeNpmIgnoreFiles: true` keeps the sources a deployment imports but a publish would
 * drop.
 */
{
    "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/deploy-scenario.schema.json",
    "deploymentProjectNames": ["@feasibleone/blong-chat"],
    "linkCreation": "script",
    "includeNpmIgnoreFiles": true
}
