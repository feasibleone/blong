#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/blong/blong/common/temp/node_modules/.pnpm/@rushstack+heft@1.2.6_@types+node@24.10.9/node_modules/@rushstack/heft/node_modules:/home/runner/work/blong/blong/common/temp/node_modules/.pnpm/@rushstack+heft@1.2.6_@types+node@24.10.9/node_modules:/home/runner/work/blong/blong/common/temp/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/blong/blong/common/temp/node_modules/.pnpm/@rushstack+heft@1.2.6_@types+node@24.10.9/node_modules/@rushstack/heft/node_modules:/home/runner/work/blong/blong/common/temp/node_modules/.pnpm/@rushstack+heft@1.2.6_@types+node@24.10.9/node_modules:/home/runner/work/blong/blong/common/temp/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@rushstack/heft/bin/heft" "$@"
else
  exec node  "$basedir/../@rushstack/heft/bin/heft" "$@"
fi
